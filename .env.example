# 對藥 (DoYeuk) provider configuration — copy to .env.local and fill in as needed.
# NEVER commit real keys. .env*.local is gitignored.
#
# Demo mode needs NONE of these (defaults: vision=mock, tts=expo-speech).

# Vision provider: anthropic | minimax | mock
EXPO_PUBLIC_VISION_PROVIDER=mock

# TTS provider: minimax | expo-speech
EXPO_PUBLIC_TTS_PROVIDER=expo-speech

# Keys (only needed when the matching provider is selected)
# EXPO_PUBLIC_ANTHROPIC_API_KEY=
# EXPO_PUBLIC_MINIMAX_API_KEY=
# EXPO_PUBLIC_MINIMAX_GROUP_ID=
