# 對藥 (DoYeuk) — empty placeholders only. NEVER put real keys in the Expo app.
# Demo / 示範 needs NONE of these (defaults: vision=mock, tts=expo-speech).
# Copy server keys to server/.env (gitignored). Never commit .env or keys.

# Vision / TTS names stay mock until the in-app overlay toggle is on.
EXPO_PUBLIC_VISION_PROVIDER=mock
EXPO_PUBLIC_TTS_PROVIDER=expo-speech

# Non-secret base URL of the in-repo live server. Leave empty for 示範-only.
EXPO_PUBLIC_LIVE_API_URL=

# Server-only (never EXPO_PUBLIC_*, never in the app). Fill in server/.env locally:
# ANTHROPIC_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=
