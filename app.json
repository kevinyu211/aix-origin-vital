{
  "expo": {
    "name": "對藥 DoYeuk",
    "slug": "aix-origin-vital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "doyeuk",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8F6"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "對藥 uses the camera only so you can photograph a demo discharge sheet and demo medicine boxes. Please use simulated / demo data only."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera"
    ],
    "extra": {
      "visionProvider": "mock",
      "ttsProvider": "expo-speech"
    }
  }
}
